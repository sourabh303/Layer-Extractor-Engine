{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractionMetadataResponse",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "layers_extracted": {
      "type": "integer"
    },
    "hardware_mode_used": {
      "type": "string"
    },
    "output_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bboxes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "localized_coordinates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      }
    }
  },
  "required": [
    "status",
    "message",
    "source_path",
    "layers_extracted",
    "hardware_mode_used",
    "output_paths",
    "bboxes",
    "localized_coordinates"
  ]
}
